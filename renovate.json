{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "schedule": [
    "before 9am on monday"
  ],
  "ignorePaths": [
    "plugins/**/evals/**"
  ],
  "prConcurrentLimit": 10,
  "commitMessagePrefix": "deps",
  "dependencyDashboardApproval": false,
  "packageRules": [
    {
      "groupName": "clojure-core",
      "matchManagers": [
        "deps-edn"
      ],
      "matchPackageNames": [
        "/^org\\.clojure:/"
      ]
    },
    {
      "groupName": "polylith",
      "matchManagers": [
        "deps-edn"
      ],
      "matchPackageNames": [
        "io.github.seancorfield/polylith-external-test-runner",
        "/^polylith//"
      ]
    },
    {
      "groupName": "build-tools",
      "matchManagers": [
        "deps-edn"
      ],
      "matchPackageNames": [
        "io.github.clojure/tools.build",
        "io.github.seancorfield/build-clj"
      ]
    },
    {
      "groupName": "foundationdb",
      "matchManagers": [
        "deps-edn"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/^org\\.foundationdb:/"
      ]
    },
    {
      "groupName": "protobuf",
      "matchManagers": [
        "deps-edn"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/^com\\.google\\.protobuf:/",
        "/^io\\.github\\.protojure:/"
      ]
    },
    {
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "nix-flake",
      "matchManagers": [
        "nix"
      ]
    }
  ]
}
