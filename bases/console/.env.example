# Copy this file to `.env.local` and fill in. Vite reads `.env.local`
# automatically; the values are inlined into the bundle at build time
# and exposed as `import.meta.env.VITE_*`. In production the nginx-
# synthesised `/env.js` overrides these at runtime.

# Public URL of the Keycloak realm the SPA authenticates against.
# The bundled chart Keycloak runs under the `/keycloak/` path
# (KC_HTTP_RELATIVE_PATH) so production-style same-origin proxying
# works without URL rewriting; that same prefix applies when Vite
# dev talks to it directly via a port-forward.
#   kubectl -n queenswood port-forward svc/queenswood-keycloak-keycloak-service 8090:8080
VITE_KEYCLOAK_URL=http://localhost:8090/keycloak

# Realm name — matches `realm` in
# infra/helm/queenswood/files/keycloak-realm.json.
VITE_KEYCLOAK_REALM=queenswood

# Public client id — matches `clients[].clientId` in the same realm
# JSON. Must equal `keycloak.consoleClientId` in the chart values.
VITE_KEYCLOAK_CLIENT_ID=queenswood-console

# Optional federated identity-provider alias. Leave empty for local
# dev so Keycloak's own login form renders (sign in with username
# `dev` / password `dev`, the user seeded into the realm JSON). Set
# to `google` in prod to redirect straight to Google without showing
# the Keycloak form.
# VITE_KEYCLOAK_IDP_HINT=google
