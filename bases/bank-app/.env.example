# Copy this file to `.env.local` and fill in. Vite reads `.env.local`
# automatically; the values are inlined into the bundle at build time
# and exposed as `import.meta.env.VITE_*`. In production the nginx-
# synthesised `/env.js` overrides these at runtime.

# Public URL of the Keycloak realm the SPA authenticates against.
# The bundled chart Keycloak runs under the `/keycloak/` path
# (KC_HTTP_RELATIVE_PATH); the same prefix applies when Vite dev
# talks to it directly via a port-forward.
VITE_KEYCLOAK_URL=http://localhost:8090/keycloak

# Realm name. bank-app targets the operator realm
# `queenswood-ops` (bank-console targets the org-user realm
# `queenswood`).
VITE_KEYCLOAK_REALM=queenswood-ops

# Public client id — matches `clients[].clientId` in the same realm
# JSON.
VITE_KEYCLOAK_CLIENT_ID=queenswood-app

# Optional federated identity-provider alias. Leave empty for local
# dev so Keycloak's own login form renders (sign in with `ops` /
# `ops`, the seeded operator user). Set to `google` in prod to
# redirect straight to Google.
# VITE_KEYCLOAK_IDP_HINT=google
