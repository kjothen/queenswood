# Applied locally by `kind-xp-install-gcp-config` via envsubst with
# the live PROJECT_ID. NOT picked up by ArgoCD — root-app only
# recursively watches infra/bootstrap/apps. Owning this resource
# outside Argo avoids a race: Argo's RespectIgnoreDifferences on the
# v1 gcp.upbound.io ProviderConfig has been observed reverting
# spec.projectID back to its in-git value, breaking every fresh
# `up-from-zero`. The v2 gcp.m.upbound.io ClusterProviderConfig
# is unaffected and stays Argo-managed.
apiVersion: gcp.upbound.io/v1beta1
kind: ProviderConfig
metadata:
  name: default
spec:
  projectID: ${PROJECT_ID}
  credentials:
    source: Secret
    secretRef:
      namespace: crossplane-system
      name: gcp-creds
      key: creds
