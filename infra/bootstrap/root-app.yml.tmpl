# Applied locally by `kind-xp-install-root` via envsubst. This is the
# ONE place per-installation values enter the bootstrap chain: each
# flows from here into the bootstrap chart's helm.parameters, then into
# the child Applications', and from there into the charts.
#
# ${PROJECT_ID} carries a random suffix per `gcloud projects create`, so
# it can't live in git. ${QUEENSWOOD_ENV} and ${QUEENSWOOD_DOMAIN} could,
# but routing them the same way means the repo holds no installation's
# names: another operator points this at their own domain without
# forking a values file, and moving domain is a Justfile edit rather
# than a rename of everything named after the environment.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/repldriven/queenswood
    targetRevision: main
    path: infra/helm/bootstrap
    helm:
      parameters:
        - name: gcpProjectId
          value: "${PROJECT_ID}"
        - name: envName
          value: "${QUEENSWOOD_ENV}"
        - name: envDomain
          value: "${QUEENSWOOD_DOMAIN}"
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      # provider-helm registers helm.crossplane.io/Release; until that
      # provider installs (wave 0), Release MRs in the queenswood-gcp
      # chart fail validation and abort the whole sync. Skipping
      # dry-run for unknown kinds lets Argo apply what it can and
      # retry the rest as CRDs come online.
      - SkipDryRunOnMissingResource=true
