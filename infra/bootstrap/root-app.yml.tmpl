# Applied locally by `kind-xp-install-root` via envsubst. This is the
# ONE place per-installation values enter the bootstrap chain: each
# flows from here into the bootstrap chart's helm.parameters, then into
# the child Applications', and from there into the charts.
#
# ${PROJECT_ID} carries a random suffix per `gcloud projects create`, so
# it can't live in git. ${QUEENSWOOD_ENV} and ${QUEENSWOOD_DOMAIN} could,
# but routing them the same way means the repo holds no installation's
# names: another operator points this at their own domain without
# forking a values file, and moving domain is a Justfile edit rather
# than a rename of everything named after the environment.
#
# ${KEYCLOAK_DB_PASSWORD} comes from `pass`. It can't be generated in a
# chart: Argo renders with `helm template`, where `lookup` returns
# nothing, so a randAlphaNum would be re-minted on every reconcile --
# and differently in each of the two charts that need it to agree. It
# reaches both from here instead, which is also what makes them agree.
#
# The three ${FDB_BACKUP_*} values come from `pass` for the same
# reason, and one further one: they have to outlive the cluster. GCS
# holds the other half of the HMAC pair, and the backup itself holds
# the other half of the encryption key -- regenerate either and the
# bucket becomes a pile of objects nothing can read.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/repldriven/queenswood
    targetRevision: main
    path: infra/helm/bootstrap
    helm:
      parameters:
        - name: gcpProjectId
          value: "${PROJECT_ID}"
        - name: envName
          value: "${QUEENSWOOD_ENV}"
        - name: envDomain
          value: "${QUEENSWOOD_DOMAIN}"
        - name: keycloakDbPassword
          value: "${KEYCLOAK_DB_PASSWORD}"
        - name: fdbBackupAccessKeyId
          value: "${FDB_BACKUP_ACCESS_KEY_ID}"
        - name: fdbBackupSecretAccessKey
          value: "${FDB_BACKUP_SECRET_ACCESS_KEY}"
        - name: fdbBackupEncryptionKey
          value: "${FDB_BACKUP_ENCRYPTION_KEY}"
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      # provider-helm registers helm.crossplane.io/Release; until that
      # provider installs (wave 0), Release MRs in the queenswood-gcp
      # chart fail validation and abort the whole sync. Skipping
      # dry-run for unknown kinds lets Argo apply what it can and
      # retry the rest as CRDs come online.
      - SkipDryRunOnMissingResource=true
