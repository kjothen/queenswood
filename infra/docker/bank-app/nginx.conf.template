server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Runtime config injection. The SPA loads /env.js BEFORE its
    # main module so window.__env is populated by the time
    # keycloak-js initialises. Values come from container env vars
    # which Helm wires from chart values, so the same image works
    # in kind and on GKE without a rebuild.
    location = /env.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 'window.__env={"keycloakUrl":"${KEYCLOAK_URL}","keycloakRealm":"${KEYCLOAK_REALM}","keycloakClientId":"${KEYCLOAK_CLIENT_ID}","keycloakIdpHint":"${KEYCLOAK_IDP_HINT}"};';
    }

    # API proxy. `proxy_pass` without a trailing slash preserves the
    # full URI, so `/v1/cash-accounts` is forwarded as
    # `/v1/cash-accounts` to ${API_UPSTREAM} — matching the dev-mode
    # Vite proxy in `vite.config.js`.
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OAuth2 token + JWKS endpoints exposed by bank-api at the root.
    location /oauth/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OIDC discovery document. RFC 8414 expects it under the issuer's
    # well-known path; we proxy it through the SPA host so clients
    # only need to know the bank-api URL.
    location /.well-known/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Same-origin Keycloak proxy. Browser hits
    # `${current-origin}/keycloak/...`; nginx forwards the path
    # unchanged to upstream, where Keycloak runs natively under
    # `/keycloak/` (`KC_HTTP_RELATIVE_PATH=/keycloak`) and so already
    # builds URLs with that prefix. We use `$http_host` (not `$host`)
    # so the request's port survives into the X-Forwarded-Host header
    # -- `$host` is the nginx-normalised hostname only, no port.
    # Keycloak (`KC_PROXY_HEADERS=xforwarded`, `KC_HOSTNAME_STRICT=false`)
    # uses that forwarded host as the authority in its generated
    # discovery URLs, redirect URLs, and JWT `iss` claim, so sign-in
    # round-trips through the SPA origin and the token's `iss`
    # matches the verifier's `expectedIssuer`.
    location /keycloak/ {
        proxy_pass ${KEYCLOAK_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # SPA fallback: client-side routing means deep links like
    # `/accounts` aren't real files; nginx returns index.html and
    # the Svelte app handles the route.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
