server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API proxy. `proxy_pass` without a trailing slash preserves the
    # full URI, so `/v1/cash-accounts` is forwarded as
    # `/v1/cash-accounts` to ${API_UPSTREAM} — matching the dev-mode
    # Vite proxy in `vite.config.js`.
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: client-side routing means deep links like
    # `/accounts` aren't real files; nginx returns index.html and
    # the Svelte app handles the route.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
