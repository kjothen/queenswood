# The instance, rendered by `just queenswood-instance-manifest`. Applied at
# sync-wave 0 by the unit's own Application, which holds every other
# manifest in this folder behind it until the composite reports ready.
#
# state is up because Cloud SQL refuses to create an already-stopped
# database. Take it down afterwards.
apiVersion: queenswood.repldriven.com/v1alpha1
kind: XQueenswoodInstance
metadata:
  name: ${INSTANCE}
  namespace: crossplane-system
spec:
  code: "${CODE}"
  env: "${ENV}"
  label: "${LABEL}"
  # Minted once and carried here. A project id is consumed permanently.
  projectId: "${PROJECT}"
  state: "up"
  # This environment's own zone, composed by XPublicZone in the
  # management project and delegated to from above. Named rather than
  # derived, because two composites have to spell one name and only one
  # of them makes it. See ADR-0028.
  ingress:
    domain: "${DOMAIN}"
    zone:
      name: "${ZONE_NAME}"
      project: "${MGMT}"
