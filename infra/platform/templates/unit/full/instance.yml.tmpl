# The instance, rendered by `just queenswood-instance-manifest`. Applied at
# sync-wave 0 by the unit's own Application, which holds every other
# manifest in this folder behind it until the composite reports ready.
#
# state is up because Cloud SQL refuses to create an already-stopped
# database. Take it down afterwards.
apiVersion: queenswood.repldriven.com/v1alpha1
kind: XQueenswoodInstance
metadata:
  name: ${INSTANCE}
  namespace: crossplane-system
spec:
  code: "${CODE}"
  env: "${ENV}"
  label: "${LABEL}"
  # Minted once and carried here. A project id is consumed permanently.
  projectId: "${PROJECT}"
  state: "up"
  # Identical in every instance, which is safe while the VPCs are
  # isolated. State them per instance before two of them peer, not
  # after: a range is immutable.
  network:
    subnetCidr: "10.10.0.0/16"
    podsCidr: "10.20.0.0/16"
    servicesCidr: "10.30.0.0/20"
    proxyCidr: "10.40.0.0/24"
    psaPrefixLength: 16
  cluster:
    machineType: "e2-standard-4"
    nodeCount: 2
    diskSize: 50
    diskType: "pd-standard"
    releaseChannel: "REGULAR"
    upgradeSettings:
      strategy: "SURGE"
      maxSurge: 1
      maxUnavailable: 0
  keycloak:
    database:
      tier: "db-custom-1-3840"
      version: "POSTGRES_18"
      edition: "ENTERPRISE"
      diskSize: 10
      diskType: "PD_HDD"
      availabilityType: "ZONAL"
      backupEnabled: false
      pointInTimeRecovery: false
      # The Cloud SQL Auth Proxy's account, shared across the instance.
      client:
        namespace: queenswood
        serviceAccount: queenswood-cloudsql-proxy
  # This environment's own zone, composed by XPublicZone in the
  # management project and delegated to from above. Named rather than
  # derived, because two composites have to spell one name and only one
  # of them makes it. See ADR-0028.
  ingress:
    domain: "${DOMAIN}"
    zone:
      name: "${ZONE_NAME}"
      project: "${MGMT}"
