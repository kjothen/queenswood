# The secret operator, rendered by `just queenswood-instance-manifest`.
# Sync-wave 1: before the config that carries resources of the kinds it
# installs, and before the bank.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ${INSTANCE}-external-secrets
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"
    description: Secret Manager to cluster Secrets, on the ${LABEL} instance
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  destination:
    name: ${INSTANCE}
    namespace: external-secrets
  source:
    repoURL: https://charts.external-secrets.io
    chart: external-secrets
    targetRevision: "${EXTERNAL_SECRETS_VERSION}"
    helm:
      # Both names are stated, not derived: the Workload Identity
      # binding the instance composite made spells
      # external-secrets/external-secrets literally, and a release named
      # for the instance produces a service account nothing is bound to.
      releaseName: external-secrets
      valuesObject:
        installCRDs: true
        serviceAccount:
          name: external-secrets
          annotations:
            iam.gke.io/gcp-service-account: sa-${INSTANCE}-secrets@${PROJECT}.iam.gserviceaccount.com
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      # SecretStore and ClusterSecretStore exceed 256KB, which a
      # client-side apply cannot write into an annotation.
      - ServerSideApply=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        factor: 2
        maxDuration: 10m
