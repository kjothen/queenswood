# The installation's environment, rendered by
# `just queenswood-environment-manifest` and committed beside its
# manifest. What is true of the whole installation and carries no
# naming or ordering consequence.
#
# Cluster-scoped, so nothing composes it -- a namespaced composite may
# not compose a cluster-scoped kind -- and Argo applies it from this
# directory like everything else.
apiVersion: apiextensions.crossplane.io/v1beta1
kind: EnvironmentConfig
metadata:
  name: ${CODE}
  labels:
    # What selects it. A composition matches this against its own
    # spec.code, because the name has to follow the code and a
    # reference takes a literal.
    installation: ${CODE}
data:
  # Read off the management project rather than committed by hand. Both
  # composites need it: a project composed without one comes up unbilled
  # and looks healthy.
  billingAccountId: "${BILLING}"
  # Read by every XManagedUnit, and the only Required patch it carries,
  # so a unit's folder says which folder it is and never which
  # repository. A fork, a mirror or a moved organisation is one edit
  # here.
  manifestRepoURL: "${MANIFEST_REPO_URL}"
  # Where the installation runs, said three ways because GCP publishes
  # no short form and a name carries the abbreviation. Stated here so an
  # instance restates none of it, and immutable in practice: a subnet
  # and a cluster are rebuilt by a move, which upjet refuses rather than
  # performs.
  region: "${REGION}"
  regionCode: "${REGION_CODE}"
  zone: "${ZONE}"
  # Capability -> principal, for the whole installation. Whole IAM
  # member strings, because the principal need not be a group, and a
  # capability left out binds nothing. Read by the subsidiary, the plane
  # and every instance, each binding the subset it can: only
  # platformViewer and clusterAdmin bind on a folder, platformAdmin
  # binds on a service account, and an instance's secretsAdmin binds on
  # its own project. Stated here so a new instance restates none of it.
  #
  # The names are ours and the principals are the organisation's. One
  # that hands you a folder may name its groups nothing like these, and
  # a capability may be answered by a user or a principalSet instead --
  # which is why these arrive resolved rather than being assembled here.
  access:
    platformViewer: ["${PLATFORM_VIEWER}"]
    platformAdmin: ["${PLATFORM_ADMIN}"]
    clusterAdmin: ["${CLUSTER_ADMIN}"]
    secretsAdmin: ["${SECRETS_ADMIN}"]
  # Which folder this installation is, and whether we made it. folderId
  # adopts an existing one and takes precedence: the composite then
  # observes it and never writes to it, so its name and its place are
  # read from GCP rather than asserted here. To compose one instead,
  # omit folderId and set the other two. Everything else in this file
  # reads the same either way -- an installation in a folder handed to
  # us is declared exactly like one in a folder of ours.
  folder:
${FOLDER_BLOCK}
