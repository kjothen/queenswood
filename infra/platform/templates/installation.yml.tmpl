# The installation manifest, rendered by `just queenswood-installation-manifest`
# and committed to the private manifests repository. Placeholders are
# substituted literally from the environment; an optional block arrives
# already rendered, or empty.
#
# It carries both ids that are consumed permanently -- the management
# project's and the recovery project's -- minted in the one call, so
# the file records both or neither. The instances join afterwards,
# composed by the plane rather than by the boot cluster.
apiVersion: platform.repldriven.com/v1alpha1
kind: XManagementPlane
metadata:
  name: ${CODE}
  namespace: crossplane-system
spec:
  code: "${CODE}"
  ${BILLING_LINE}
${RECOVERY_BLOCK}
  management:
    projectId: "${MGMT}"
    ${MGMT_ADOPT}
    source:
      repoURL: "${SOURCE_REPO}"
      targetRevision: "${SOURCE_REVISION}"
      pathPrefix: "${SOURCE_PATH_PREFIX}"
    manifestRepoURL: "${MANIFEST_REPO_URL}"
