{:compact-views #{},
 :default-profile-name "bank",
 :interface-ns "interface",
 :projects {"development" {:alias "dev"},
            ;; schema and test-resources provide centralised Avro schemas
            ;; and shared classpath resources (Testcontainers configs,
            ;; application-test.yml files). Polylith tracks source imports
            ;; only, so :necessary suppresses false-positive warnings.
            "bank-operational-processors-service"
              {:alias "ops",
               :necessary ["bank-resources"
                           "bank-schema" "bank-test-resources" "test-schema"
                           "command-schema" "event-schema"
                           "test-resources"]},
            "bank-financial-processors-service"
              {:alias "fin",
               :necessary ["bank-resources"
                           "bank-schema" "bank-test-resources" "test-schema"
                           "command-schema" "event-schema"
                           "test-resources"]},
            "bank-api-service"
              {:alias "api",
               :necessary ["bank-resources"
                           "bank-schema" "bank-test-resources" "test-schema"
                           "command-schema" "event-schema"
                           "test-resources"]},
            "bank-bootstrap-service"
              {:alias "bbs",
               :necessary ["bank-resources" "bank-schema"
                           "bank-test-resources" "test-schema"
                           "test-resources"]},
            "bank-migrator-service"
              {:alias "mig",
               :necessary ["bank-resources"
                           "bank-schema" "test-schema"
                           "command-schema" "event-schema"
                           "test-resources"]},
            "bank-clearbank-adapter-service"
              {:alias "cba",
               :necessary ["bank-resources"
                           "bank-schema" "bank-test-resources"
                           "command-schema" "event-schema"
                           "test-resources" "test-schema" "testcontainers"]},
            "bank-clearbank-simulator-service"
              {:alias "cbs",
               :necessary ["test-resources"]},
            "bank-onfido-adapter-service"
              {:alias "ioa",
               :necessary ["bank-resources"
                           "bank-schema" "bank-test-resources"
                           "command-schema" "event-schema"
                           "test-resources"]},
            "bank-onfido-simulator-service"
              {:alias "ios",
               :necessary ["test-resources"]},
            "bank-uk-companies-house-simulator-service"
              {:alias "ucs",
               :necessary ["test-resources"]}},
 :tag-patterns {:release "v[0-9]*", :stable "stable-*"},
 :test {:create-test-runner
          com.repldriven.mono.external-test-runner.core/create},
 :top-namespace "com.repldriven.mono",
 :vcs {:auto-add true, :name "git"}}
