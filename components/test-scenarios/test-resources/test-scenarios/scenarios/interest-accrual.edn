{:name "Interest accrual + capitalisation on a customer savings account"
 :tags #{:edn-only :interest :savings}
 ;; Tenant onboards a person-party, defines and publishes a savings
 ;; product with a non-zero interest rate, opens a customer savings
 ;; account, funds it from settlement, then runs accrue and capitalise.
 ;; Both steps post real transactions:
 ;;
 ;;   accrual     debits  settlement.interest-payable
 ;;               credits customer.interest-accrued
 ;;
 ;;   capitalise  debits  settlement.default        \  pair: pays
 ;;               credits customer.interest-paid    /  the interest
 ;;               debits  customer.interest-accrued \  pair: clears
 ;;               credits settlement.interest-payable/  the accrual
 ;;
 ;; The customer's *available* balance — what `project-balances`
 ;; reads — covers `default` + `default-pending-*` only, so neither
 ;; accrual nor capitalisation visibly moves it. Locking in the
 ;; cross-balance-type effects needs richer projections (see plan
 ;; task 6.x); this scenario checks the wiring runs without an
 ;; anomaly.
 :given [{:command :create-bank :args []}                         ; org-0,
                                                                  ; prod-0
                                                                  ; (settlement),
                                                                  ; party-0
                                                                  ; (org),
                                                                  ; acct-0
         {:command :create-product :args [:bank-0 :savings 3650]} ; prod-1
                                                                  ; (savings,
                                                                  ; draft,
                                                                  ; 36.5% AER)
         {:command :publish-product :args [:prod-1]} ; prod-1 published
         {:command :create-person-party :args [:bank-0]}           ; party-1
                                                                   ; (person,
                                                                   ; auto-active)
         {:command :open-account :args [:bank-0 :party-1 :prod-1]} ; acct-1
                                                                   ; (savings,
                                                                   ; customer)
         {:command :inbound-transfer :args [:acct-0 100000]}           ; £1,000
                                                                       ; into
                                                                       ; settlement
         {:command :internal-transfer :args [:acct-0 :acct-1 100000]}] ; settlement
                                                                       ; →
                                                                       ; savings
 :when [{:command :accrue-interest :args [:bank-0 20260501]}
        {:command :capitalize-interest :args [:bank-0 20260501]}]
 :then [{:command :assert-no-anomaly :args []}]}
