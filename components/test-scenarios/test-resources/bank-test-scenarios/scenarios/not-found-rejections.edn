{:name "not-found rejections pin contractual kinds across all read-side resources"
 :tags #{:rejection :contracts}

 ;; One scenario, one boot, every `:not-found` rejection kind that
 ;; bank-api maps to a 404. Locking these in protects the client
 ;; contract: each `error/kind` is what an API response surfaces,
 ;; and the bank-api error-mapping layer keys off these kinds.

 :given
 [{:command :create-bank      :args []}
  {:command :assert-outcome  :args [:succeeded]}]

 :when []

 :then
 [;; --- Org-scoped reads -------------------------------------------
  {:command :get-account
   :args [:bank-0 "acc.unknown"]}
  {:command :assert-rejection-kind
   :args [:cash-account/not-found]}

  {:command :get-party
   :args [:bank-0 "pty.unknown"]}
  {:command :assert-rejection-kind
   :args [:party/not-found]}

  {:command :get-idv
   :args [:bank-0 "idv.unknown"]}
  {:command :assert-rejection-kind
   :args [:idv/not-found]}

  {:command :get-payee-check
   :args [:bank-0 "pck.unknown"]}
  {:command :assert-rejection-kind
   :args [:payee-check/not-found]}

  {:command :get-product
   :args [:bank-0 "prd.unknown"]}
  {:command :assert-rejection-kind
   :args [:cash-account-product/product-not-found]}

  ;; product exists; version doesn't
  {:command :create-product
   :args [:bank-0 :current 0]}
  {:command :assert-outcome :args [:succeeded]}

  {:command :get-product-version
   :args [:bank-0 :prod-1 "prv.unknown"]}
  {:command :assert-rejection-kind
   :args [:cash-account-product/version-not-found]}

  {:command :publish-product
   :args [:bank-0 :prod-1 "prv.unknown"]}
  {:command :assert-rejection-kind
   :args [:cash-account-product/version-not-found]}

  {:command :update-product-draft
   :args [:bank-0 :prod-1 "prv.unknown"]}
  {:command :assert-rejection-kind
   :args [:cash-account-product/version-not-found]}

  ;; --- Platform-level reads ---------------------------------------
  {:command :get-bank
   :args ["bnk.unknown"]}
  {:command :assert-rejection-kind
   :args [:bank/not-found]}

  {:command :get-policy
   :args ["pol.unknown"]}
  {:command :assert-rejection-kind
   :args [:policy/not-found]}

  {:command :get-policy-binding
   :args ["pbn.unknown"]}
  {:command :assert-rejection-kind
   :args [:policy-binding/not-found]}

  {:command :get-balance
   :args ["acc.unknown" :balance-type-default "GBP" :balance-status-posted]}
  {:command :assert-rejection-kind
   :args [:balance/not-found]}]}
