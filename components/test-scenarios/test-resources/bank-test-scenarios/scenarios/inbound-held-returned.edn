{:name "Inbound held then returned — account never credited"
 :tags #{:transfers :inbound :held}

 ;; A held inbound that ClearBank declines is returned to the remitter:
 ;; nothing posts on our books, so the account stays at zero.

 :given
 [{:command :create-bank :args []}]

 :when
 [{:command :hold-inbound   :args [:acct-0 1000]}
  {:command :return-inbound :args [:acct-0]}]

 :then
 [{:command :assert-no-anomaly :args []}
  {:command :assert-balance    :args [:acct-0 0]}]}
