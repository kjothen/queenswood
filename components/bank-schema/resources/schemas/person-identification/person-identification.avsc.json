{
  "type": "record",
  "name": "PersonIdentification",
  "namespace": "com.repldriven.mono.person_identification",
  "fields": [
    {"name": "party_id",      "type": "string"},
    {"name": "given_name",    "type": "string"},
    {"name": "middle_names",  "type": ["null", "string"], "default": null},
    {"name": "family_name",   "type": "string"},
    {"name": "date_of_birth", "type": "int", "doc": "YYYYMMDD"},
    {"name": "nationality",   "type": "string", "doc": "ISO 3166-1 alpha-2"},
    {"name": "address", "type": {
      "type": "record",
      "name": "Address",
      "fields": [
        {"name": "flat_number",     "type": ["null", "string"], "default": null},
        {"name": "building_number", "type": ["null", "string"], "default": null},
        {"name": "building_name",   "type": ["null", "string"], "default": null},
        {"name": "street",          "type": "string"},
        {"name": "sub_street",      "type": ["null", "string"], "default": null},
        {"name": "town",            "type": "string"},
        {"name": "state",           "type": ["null", "string"], "default": null},
        {"name": "postcode",        "type": "string"},
        {"name": "country",         "type": "string"},
        {"name": "start_date",      "type": ["null", "string"], "default": null}
      ]
    }},
    {"name": "created_at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "updated_at", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
