{:name "Full happy path: two parties, two products, transfers, payment, interest"
 :tags #{:e2e :happy-path}

 ;; Mirrors bank-test-scenarios/full-happy-path.edn end-to-end via
 ;; the API:
 ;;
 ;;   - Customer org (settlement account auto-created)
 ;;   - Two products: current (rate 0) and savings (rate 3650 bps)
 ;;   - Two person parties — Arthur and Ford — each with a current
 ;;     and a savings account
 ;;   - Settlement funded with £50,000 via the simulate endpoint
 ;;   - Each party rewarded £1,000 into their current account
 ;;   - Arthur moves £750 current → savings
 ;;   - Ford moves £350 current → savings
 ;;   - Ford pays £25 outbound through the scheme path
 ;;   - Daily interest accrues on the savings products and is
 ;;     capitalised
 ;;
 ;; All amounts in pence. Balances asserted via the `:default`
 ;; / `:interest-payable` entries on GET /v1/cash-accounts/{id}/
 ;; balances; the `:m/embeds` matcher pins specific entries
 ;; without constraining what else is present.

 :given
 ;; --- Org + party setup --------------------------------------------
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "Full Happy Path Customer"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}

  ;; Two products: current (0 bps) and savings (3650 bps)
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :body {:name "Current"
                    :product-type "current"
                    :balance-sheet-side "liability"
                    :allowed-currencies ["GBP"]
                    :balance-products
                    [{:balance-type "default" :balance-status "posted"}
                     {:balance-type "default"
                      :balance-status "pending-incoming"}
                     {:balance-type "default"
                      :balance-status "pending-outgoing"}
                     {:balance-type "interest-accrued"
                      :balance-status "posted"}
                     {:balance-type "interest-paid"
                      :balance-status "posted"}]
                    :allowed-payment-address-schemes ["scan"]
                    :interest-rate-bps 0
                    :valid-from "2026-01-01"}}
   :as :current-draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
             :path-params {:product-id [:ref :current-draft :product-id]
                           :version-id [:ref :current-draft :version-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}

  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :body {:name "Savings"
                    :product-type "savings"
                    :balance-sheet-side "liability"
                    :allowed-currencies ["GBP"]
                    :balance-products
                    [{:balance-type "default" :balance-status "posted"}
                     {:balance-type "default"
                      :balance-status "pending-incoming"}
                     {:balance-type "default"
                      :balance-status "pending-outgoing"}
                     {:balance-type "interest-accrued"
                      :balance-status "posted"}
                     {:balance-type "interest-paid"
                      :balance-status "posted"}]
                    :allowed-payment-address-schemes ["scan"]
                    :interest-rate-bps 3650
                    :valid-from "2026-01-01"}}
   :as :savings-draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
             :path-params {:product-id [:ref :savings-draft :product-id]
                           :version-id [:ref :savings-draft :version-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}

  ;; Arthur Dent → :arthur (auto-activates via IDV chain)
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-create-arthur-party"}
             :body {:type "person"
                    :display-name "Arthur Dent"
                    :given-name "Arthur"
                    :family-name "Dent"
                    :date-of-birth "1950-07-27"
                    :nationality "GB"
                    :national-identifier {:type "national-insurance"
                                          :value "TN555001A"
                                          :issuing-country "GB"}}}
   :as :arthur
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :arthur :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}

  ;; Ford Prefect → :ford
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-create-ford-party"}
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"
                    :date-of-birth "1948-04-01"
                    :nationality "GB"
                    :national-identifier {:type "national-insurance"
                                          :value "TN555002B"
                                          :issuing-country "GB"}}}
   :as :ford
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :ford :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}

  ;; Customer accounts: arthur-current, arthur-savings,
  ;; ford-current, ford-savings — open and wait for "opened".
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-open-arthur-current"}
             :body {:party-id [:ref :arthur :party-id]
                    :name "Arthur Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product-id]}}
   :as :arthur-current
   :assert {:status 200 :body {:account-status "opening"}}}
  ;; Re-bind :arthur-current to the polled GET response so later
  ;; steps see the full record (including :bban, which the POST
  ;; response doesn't expose).
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "opened"}}
   :as :arthur-current}

  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-open-arthur-savings"}
             :body {:party-id [:ref :arthur :party-id]
                    :name "Arthur Savings"
                    :currency "GBP"
                    :product-id [:ref :savings-draft :product-id]}}
   :as :arthur-savings
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :arthur-savings :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "opened"}}}

  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-open-ford-current"}
             :body {:party-id [:ref :ford :party-id]
                    :name "Ford Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product-id]}}
   :as :ford-current
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :ford-current :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "opened"}}}

  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-open-ford-savings"}
             :body {:party-id [:ref :ford :party-id]
                    :name "Ford Savings"
                    :currency "GBP"
                    :product-id [:ref :savings-draft :product-id]}}
   :as :ford-savings
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :ford-savings :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "opened"}}}

  ;; --- Money in ---------------------------------------------------
  ;; £50,000 into settlement
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/organizations/{org-id}/inbound-transfer"
             :path-params {:org-id [:ref :org-0 :organization-id]}
             :auth :admin
             :headers {:idempotency-key "ik-fhp-inbound-settlement"}
             :body {:account-id [:ref :org-0 :accounts 0 :account-id]
                    :amount 5000000
                    :currency "GBP"}}
   :assert {:status 200}}

  ;; £1,000 reward to each party's current account
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-reward-arthur"}
             :body {:debtor-account-id [:ref :org-0 :accounts 0 :account-id]
                    :creditor-account-id [:ref :arthur-current :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Reward Arthur"}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-reward-ford"}
             :body {:debtor-account-id [:ref :org-0 :accounts 0 :account-id]
                    :creditor-account-id [:ref :ford-current :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Reward Ford"}}
   :assert {:status 200}}]

 :when
 ;; --- Customer activity ------------------------------------------
 ;; Arthur: £750 current → savings
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-arthur-cur-to-sav"}
             :body {:debtor-account-id [:ref :arthur-current :account-id]
                    :creditor-account-id [:ref :arthur-savings :account-id]
                    :currency "GBP"
                    :amount 75000
                    :reference "Arthur saves"}}
   :assert {:status 200}}
  ;; Ford: £350 current → savings
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-ford-cur-to-sav"}
             :body {:debtor-account-id [:ref :ford-current :account-id]
                    :creditor-account-id [:ref :ford-savings :account-id]
                    :currency "GBP"
                    :amount 35000
                    :reference "Ford saves"}}
   :assert {:status 200}}
  ;; Ford: £25 outbound to Arthur, settling the beer and nuts debt.
  ;; Arthur's BBAN is sort-code ++ account-number from the SCAN
  ;; payment address on his current account.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth :org-0-token
             :headers {:idempotency-key "ik-fhp-ford-outbound"}
             :body {:debtor-account-id [:ref :ford-current :account-id]
                    :creditor-bban [:ref :arthur-current :bban]
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Beer and nuts"}}
   :assert {:status 200}}]

 :then
 ;; Outbound is async (scheme command → ClearBank → settled event).
 ;; Give the chain ~2s to settle before checking balances.
 ;;
 ;; --- Pre-interest balances --------------------------------------
 ;;   settlement (acct-0): 5_000_000 - 100_000 - 100_000 = 4_800_000
 ;;   Arthur cur          1_000_00 - 750_00 + 25_00   =    27_500
 ;;   Arthur sav                  + 750_00            =    75_000
 ;;   Ford   cur          1_000_00 - 350_00 - 25_00   =    62_500
 ;;   Ford   sav                  + 350_00            =    35_000
 [{:command :wait :duration-ms 2000}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :org-0 :accounts 0 :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 4800000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 27500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-savings :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 75000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-current :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 62500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-savings :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 35000 :currency "GBP"}}}}

  ;; --- Interest run -----------------------------------------------
  ;; Daily interest on savings at 3650 bps:
  ;;   Arthur sav  75_000 → 75p accrued
  ;;   Ford   sav  35_000 → 35p accrued
  ;; Both land in customer.interest-accrued (not visible in
  ;; available); settlement.interest-payable goes -110.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/organizations/{org-id}/accrue"
             :path-params {:org-id [:ref :org-0 :organization-id]}
             :auth :admin
             :headers {:idempotency-key "ik-fhp-accrue-interest"}
             :body {:as-of-date "2026-05-01"}}
   :assert {:status 200}}

  ;; settlement now also has interest-payable -110
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :org-0 :accounts 0 :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 4799890 :currency "GBP"}}}}

  ;; Capitalisation:
  ;;   settlement.default      -= 75 + 35 → 4_799_890
  ;;   Arthur savings.default  += 75      →    75_075
  ;;   Ford   savings.default  += 35      →    35_035
  ;;   current accounts unchanged.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/organizations/{org-id}/capitalize"
             :path-params {:org-id [:ref :org-0 :organization-id]}
             :auth :admin
             :headers {:idempotency-key "ik-fhp-capitalize"}
             :body {:as-of-date "2026-05-01"}}
   :assert {:status 200}}

  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :org-0 :accounts 0 :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 4799890 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 27500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-savings :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 75075 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-current :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 62500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-savings :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:available-balance {:value 35035 :currency "GBP"}}}}]}
