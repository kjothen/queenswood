{:name "Closing an account with a non-zero balance is rejected"
 :tags #{:cash-accounts :api :unhappy :lifecycle}

 ;; QNS-19: close is a domain invariant guarded on the account's
 ;; live balance buckets — a posted credit left on the account
 ;; blocks close with a named 409, distinct from the QNS-11
 ;; :invalid-status source-state guard. No tenant policy grants the
 ;; :cash-account-action-close-non-zero opt-out here, so the default
 ;; deny fires.

 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Non Zero Close Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}

  ;; Active party
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-nzc-create-party"}
             :body {:type "person"
                    :display-name "Non Zero Customer"
                    :given-name "Non"
                    :family-name "Zero"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN888002B"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}

  ;; Published product
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
             :path-params {:product-id [:ref :draft :product-id]
                           :version-id [:ref :draft :version-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}

  ;; Open the cash-account and wait for opened
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-nzc-open-account"}
             :body {:party-id [:ref :party-0 :party-id]
                    :name "Non Zero Balance Account"
                    :currency "GBP"
                    :product-id [:ref :draft :product-id]}}
   :as :account-0
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "opened"}}}

  ;; Fund the account so it carries a posted, non-zero balance.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/banks/{bank-id}/inbound-transfer"
             :path-params {:bank-id [:ref :org-0 :bank-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-nzc-fund-account"}
             :body {:account-id [:ref :account-0 :account-id]
                    :amount 5000
                    :currency "GBP"}}
   :assert {:status 200}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   :until {:status 200
           :body {:available-balance {:value 5000 :currency "GBP"}}}}]

 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-nzc-close-account"}}
   :assert {:status 409
            :problem {:type ":cash-account/non-zero-on-close"}}}

  ;; The account stays opened — close never applied.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:account-status "opened"}}}]}
