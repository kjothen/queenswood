{:name "Tenant lists their API keys"
 :tags #{:api-keys :api :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "API Keys Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/api-keys"
             :auth [:ref :org-0 :api-key-secret]}
   :assert {:status 200
            :body {:api-keys [{:organization-id [:ref :org-0 :organization-id]
                               :name "default"
                               :key-prefix [:m/regex ".+"]
                               :key-hash [:m/absent]}]}}}]}
