{:name "Tenant retrieves a product with its version inline"
 :tags #{:cash-account-products :api :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "Get Product Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :api-key-secret]
             :body {:name "Savings Account"
                    :product-type "savings"
                    :balance-sheet-side "liability"
                    :allowed-currencies ["GBP"]
                    :balance-products [{:balance-type "default"
                                        :balance-status "posted"}]
                    :allowed-payment-address-schemes ["scan"]
                    :interest-rate-bps 250
                    :valid-from "2026-01-01"}}
   :as :product-0
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-account-products/{product-id}"
             :path-params {:product-id [:ref :product-0 :product-id]}
             :auth [:ref :org-0 :api-key-secret]}
   :assert {:status 200
            :body {:product-id [:ref :product-0 :product-id]
                   :versions [{:version-id [:ref :product-0 :version-id]
                               :status "draft"
                               :name "Savings Account"}]}}}]}
