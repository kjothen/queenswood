{:name "Tenant publishes a draft version"
 :tags #{:cash-account-products :api :happy :lifecycle}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "Publish Draft Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :api-key-secret]
             :body {:name "Current Account"
                    :product-type "current"
                    :balance-sheet-side "liability"
                    :allowed-currencies ["GBP"]
                    :balance-products [{:balance-type "default"
                                        :balance-status "posted"}]
                    :allowed-payment-address-schemes ["scan"]
                    :interest-rate-bps 0
                    :valid-from "2026-01-01"}}
   :as :draft
   :assert {:status 201
            :body {:status "draft"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
             :path-params {:product-id [:ref :draft :product-id]
                           :version-id [:ref :draft :version-id]}
             :auth [:ref :org-0 :api-key-secret]}
   :assert {:status 200
            :body {:product-id [:ref :draft :product-id]
                   :version-id [:ref :draft :version-id]
                   :status "published"}}}]}
