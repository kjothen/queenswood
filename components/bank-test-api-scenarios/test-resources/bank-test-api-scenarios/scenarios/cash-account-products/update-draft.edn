{:name "Tenant updates a draft version"
 :tags #{:cash-account-products :api :happy :lifecycle}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "Update Draft Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :body {:name "Initial Name"
                    :product-type "current"
                    :balance-sheet-side "liability"
                    :allowed-currencies ["GBP"]
                    :balance-products [{:balance-type "default"
                                        :balance-status "posted"}]
                    :allowed-payment-address-schemes ["scan"]
                    :interest-rate-bps 0
                    :valid-from "2026-01-01"}}
   :as :draft
   :assert {:status 201
            :body {:status "draft" :name "Initial Name"}}}]
 :when
 [{:command :api/request
   :request {:method :put
             :path "/v1/cash-account-products/{product-id}/versions/{version-id}"
             :path-params {:product-id [:ref :draft :product-id]
                           :version-id [:ref :draft :version-id]}
             :auth :org-0-token
             :body {:name "Renamed"
                    :product-type "current"
                    :balance-sheet-side "liability"
                    :allowed-currencies ["GBP" "EUR"]
                    :balance-products [{:balance-type "default"
                                        :balance-status "posted"}]
                    :allowed-payment-address-schemes ["scan"]
                    :interest-rate-bps 150
                    :valid-from "2026-01-01"}}
   :assert {:status 200
            :body {:product-id [:ref :draft :product-id]
                   :version-id [:ref :draft :version-id]
                   :version-number 1
                   :status "draft"
                   :name "Renamed"
                   :allowed-currencies ["GBP" "EUR"]
                   :interest-rate-bps 150}}}]}
