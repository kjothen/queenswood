{:name "Updating a published version is rejected as immutable"
 :tags #{:cash-account-products :api :unhappy :lifecycle}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Immutable Update Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :body {:name "v1"
                    :product-type "current"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :valid-from "2026-01-01"}}
   :as :v1
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
             :path-params {:product-id [:ref :v1 :product-id]
                           :version-id [:ref :v1 :version-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}]
 :when
 [{:command :api/request
   :request {:method :put
             :path "/v1/cash-account-products/{product-id}/versions/{version-id}"
             :path-params {:product-id [:ref :v1 :product-id]
                           :version-id [:ref :v1 :version-id]}
             :auth :org-0-token
             :body {:name "Attempted Rename"
                    :product-type "current"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :valid-from "2026-01-01"}}
   :assert {:status 409
            :problem {:type ":cash-account-product/version-immutable"}}}]}
