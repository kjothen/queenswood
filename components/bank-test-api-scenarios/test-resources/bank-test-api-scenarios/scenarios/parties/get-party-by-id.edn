{:name "Tenant retrieves a party by id"
 :tags #{:parties :api :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "Get Party Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :org-0 :api-key-secret]
             :headers {:idempotency-key "ik-get-party-by-id-create"}
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"
                    :date-of-birth "1948-04-01"
                    :nationality "GB"
                    :national-identifier {:type "national-insurance"
                                          :value "TN000002B"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :api-key-secret]}
   :assert {:status 200
            :body {:party-id [:ref :party-0 :party-id]
                   :type "person"
                   :display-name "Ford Prefect"}}}]}
