{:name "Service-account JWT is rejected by the admin-only org creation endpoint"
 :tags #{:organizations :api :auth :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "First Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :org-0-token
             :body {:name "Second Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :assert {:status 403}}]}
