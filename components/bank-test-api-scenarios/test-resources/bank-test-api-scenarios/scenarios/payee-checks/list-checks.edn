{:name "Tenant lists their payee checks"
 :tags #{:payee-checks :api :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/organizations"
             :auth :admin
             :body {:name "Payee Check List Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payee-checks"
             :auth [:ref :org-0 :api-key-secret]
             :body {:creditor-name "Arthur Dent"
                    :account {:sort-code "040062"
                              :account-number "12345678"}
                    :account-type "personal"}}
   :as :check-0
   :assert {:status 201}}]

 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/payee-checks"
             :auth [:ref :org-0 :api-key-secret]}
   :assert {:status 200
            :body {:items [{:check-id [:ref :check-0 :check-id]
                            :result {:match-result "match"}}]}}}]}
