{:name "Force-starting the seeded daily-interest job accrues + capitalises"
 :tags #{:scheduler :interest :savings :edn-only}

 ;; Bank provisioning seeds a `daily-interest` job ([accrue,
 ;; capitalize], daily). Set up a funded customer savings account, then
 ;; force-start the job: run-job executes both tasks sequentially and
 ;; records a succeeded SchedulerRun. Mirrors interest-accrual.edn but
 ;; drives the run through the scheduler engine rather than the interest
 ;; verbs directly — proves seeding + the run handler end to end.
 :given
 [{:command :create-bank          :args []}
  {:command :create-product       :args [:bank-0 :savings 3650]}
  {:command :publish-product      :args [:prod-1]}
  {:command :create-person-party  :args [:bank-0]}
  {:command :open-account         :args [:bank-0 :party-1 :prod-1]}
  {:command :inbound-transfer     :args [:acct-0 100000]}
  {:command :internal-transfer    :args [:acct-0 :acct-1 100000]}]

 :when
 [{:command :force-start-job :args [:bank-0 "daily-interest"]}]

 :then
 [{:command :assert-no-anomaly :args []}]}
