{:name "Daily inbound-payment count limit is enforced per org"
 :tags #{:payments :inbound :limit :rejection}

 ;; Bind a tight `max 2 inbound-payments per day` policy to org-0,
 ;; then settle two inbound transfers (within cap) and a third
 ;; (over cap). The third must be rejected with
 ;; `:policy/limit-exceeded`; the recipient balance must reflect
 ;; only the two successful credits.
 :given
 [{:command :create-org :args []}
  {:command :bind-policy
   :args [:org-0
          {:name "Test: max 2 inbound payments per day"
           :category :policy-category-restricted
           :limits [{:kind {:inbound-payment {}}
                     :bound {:kind {:max
                                    {:aggregate
                                     {:kind
                                      {:count
                                       {:value 2
                                        :window :time-window-daily}}}}}}
                     :reason "Test-bound daily count cap"}]}]}
  {:command :inbound-transfer :args [:acct-0 100]}
  {:command :inbound-transfer :args [:acct-0 100]}]

 :when
 [{:command :inbound-transfer :args [:acct-0 100]}]

 :then
 [{:command :assert-rejection-kind :args [:policy/limit-exceeded]}
  {:command :assert-balance        :args [:acct-0 200]}]}
