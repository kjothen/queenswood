{:name "Suspending a pending party is rejected"
 :tags #{:api :parties :lifecycle :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Suspend Pending Party Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 ;; The party is created and immediately targeted, before the IDV to
 ;; activation cascade has a chance to land, so it is still "pending"
 ;; when the suspend request arrives.
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-suspend-pending-party"}
             :body {:type "person"
                    :display-name "Pending Party"
                    :given-name "Pending"
                    :family-name "Party"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN888014A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/suspend"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-suspend-pending-party-suspend"}}
   :assert {:status 409 :body {:type ":party/invalid-status"}}}]}
