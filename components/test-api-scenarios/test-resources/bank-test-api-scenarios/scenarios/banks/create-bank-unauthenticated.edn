{:name "Unauthenticated request rejected"
 :tags #{:banks :api :unhappy :auth}
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :body {:name "No Auth Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :assert {:status 401}}]}
