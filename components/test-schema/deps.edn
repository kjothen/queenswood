;; Domain-agnostic protobuf fixture for testing FDB fundamentals — record
;; save/load, scan, query, changelog — without dragging the banking schema
;; into `components/fdb`. Ported from mono, which dropped it in v0.0.17.
;;
;; The record layer comes from the same pin as `components/fdb`, so the two
;; cannot drift; javac compiles the generated classes against its record
;; annotations. See `components/schema/deps.edn` for why the pin sits in
;; top-level deps and is repeated under :build.
{:paths ["src" "gen" "resources" "classes"]
 :deps {pin/protojure {:local/root "../../deps/protojure"}
        pin/fdb {:local/root "../../deps/fdb"}}
 :deps/prep-lib {:alias :build :fn build/gen-proto :ensure "classes"}
 :aliases {:test {:extra-paths []}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.12"}
                          pin/fdb {:local/root "../../deps/fdb"}}
                   :extra-deps {com.repldriven.queenswood/build
                                {:local/root "../../bases/build"}}
                   :paths ["."]}}}
